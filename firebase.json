{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      ".firebaserc",
      "README.md",
      "README.txt",
      "SETUP_INSTRUCTIONS.txt",
      "UPLOAD_INSTRUCTIONS.txt",

      ".git/**",
      ".github/**",
      ".firebase/**",
      "functions/**",
      "**/node_modules/**",

      "driver/**",
      "rider/**",
      "Fare-Ride-Customer-Web/**",
      "public/**",

      "*.backup",
      "users.json"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
