{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      ".firebaserc",
      "README.md",
      "README.txt",
      "SETUP_INSTRUCTIONS.txt",
      "UPLOAD_INSTRUCTIONS.txt",
      ".git/**",
      ".github/**",
      "functions/**",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/fare-estimate",
        "function": {
          "functionId": "fareEstimate",
          "region": "us-east1"
        }
      },
      {
        "source": "/api/create-ride",
        "function": {
          "functionId": "createRide",
          "region": "us-east1"
        }
      },
      {
        "source": "/api/pricing",
        "function": {
          "functionId": "pricing",
          "region": "us-east1"
        }
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
