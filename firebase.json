{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      ".firebaserc",
      "README.md",
      "README.txt",
      "SETUP_INSTRUCTIONS.txt",
      "UPLOAD_INSTRUCTIONS.txt",
      "MULTI_SERVICE.md",
      "preview.cjs",
      "**/*.test.mjs",
      ".git/**",
      ".github/**",
      ".firebase/**",
      "functions/**",
      "**/node_modules/**",
      "driver/**",
      "rider/**",
      "Fare-Ride-Customer-Web/**",
      "public/**",
      "*.backup",
      "users.json",
      "firestore-towing-console.rules",
      "storage.rules",
      "STORAGE_UPLOAD_FIX.md",
      "firebase.storage.test.json"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
