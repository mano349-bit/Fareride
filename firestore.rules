rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function towAssignmentRequest() { return resource.data.get('serviceType', 'ride') == 'tow' && resource.data.status == 'requested' && request.resource.data.status == 'accepted'; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }
    function driverAvailable(uid) {
      let presence = get(/databases/$(database)/documents/driverPresence/$(uid)).data;
      return presence.available == true && presence.updatedAt <= request.time
        && presence.updatedAt > request.time - duration.value(90, 's');
    }
    function driverAccount() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'driver';
    }
    match /admins/{uid} {
      allow get: if owner(uid);
      allow list, write: if false;
    }
    match /users/{uid} {
      allow get: if owner(uid) || admin();
      allow list: if admin();
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'email', 'role', 'fullName', 'phone', 'accountStatus', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['rider', 'driver']
        && request.resource.data.accountStatus == 'pending';
      allow update: if (owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'phone', 'email', 'updatedAt'])
        && request.resource.data.email == request.auth.token.email)
        || (admin() && request.resource.data.uid == resource.data.uid && request.resource.data.role == resource.data.role);
      allow delete: if false;
    }
    match /{collection}/{applicationId} {
      allow get: if collection in ['riderApplications', 'driverApplications']
        && (admin() || (signedIn() && applicationId == (collection == 'riderApplications' ? 'rider_' : 'driver_') + request.auth.uid));
      allow list: if collection in ['riderApplications', 'driverApplications'] && admin();
      allow create: if collection in ['riderApplications', 'driverApplications']
        && signedIn()
        && request.resource.data.keys().hasOnly(['applicationId', 'role', 'uid', 'fullName', 'phone', 'email', 'dateOfBirth', 'address', 'city', 'state', 'zipCode', 'documents', 'status', 'adminNotes', 'submittedAt', 'approvedAt', 'suspendedAt', 'updatedAt', 'ssnLast4', 'vehicleYear', 'vehicleMake', 'vehicleModel', 'vehicleColor', 'plateNumber', 'insuranceCompany', 'insurancePolicyNumber', 'insuranceExpiration', 'applicantNotes', 'rating'])
        && applicationId == (collection == 'riderApplications' ? 'rider_' : 'driver_') + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.applicationId == applicationId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == (collection == 'riderApplications' ? 'rider' : 'driver')
        && request.resource.data.status == 'new'
        && request.resource.data.adminNotes == ''
        && request.resource.data.approvedAt == null
        && request.resource.data.suspendedAt == null;
      allow update: if collection in ['riderApplications', 'driverApplications'] && admin()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.applicationId == resource.data.applicationId;
      allow delete: if false;
    }
    // The confirmed crop is private to the rider until it is shared for an active job.
    match /riderFaceProfiles/{uid} {
      function approvedRider() {
        return owner(uid)
          && get(/databases/$(database)/documents/users/$(uid)).data.role == 'rider'
          && get(/databases/$(database)/documents/users/$(uid)).data.accountStatus in ['approved', 'active'];
      }
      function validFace(photo) {
        return photo is string && photo.size() <= 200000
          && photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+');
      }
      allow get: if owner(uid) || admin();
      allow list: if false;
      allow create, update: if approvedRider()
        && request.resource.data.keys().hasOnly(['uid', 'image', 'updatedAt'])
        && request.resource.data.uid == uid
        && validFace(request.resource.data.image)
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 40;
      allow delete: if false;
    }
    // Drivers receive only the confirmed face crop for their currently assigned job.
    match /riderFacePhotos/{rideId} {
      function activeRide() {
        return get(/databases/$(database)/documents/rides/$(rideId)).data;
      }
      function activeParticipant() {
        return signedIn() && activeRide().status in ['accepted', 'arrived', 'started']
          && (activeRide().riderId == request.auth.uid || activeRide().driverId == request.auth.uid);
      }
      function approvedRider() {
        return signedIn()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'rider'
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus in ['approved', 'active'];
      }
      function validFace(photo) {
        return photo is string && photo.size() <= 200000
          && photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+');
      }
      allow get: if admin() || (activeParticipant()
        && (!exists(/databases/$(database)/documents/riderFacePhotos/$(rideId))
          || resource.data.riderId == activeRide().riderId));
      allow list: if false;
      allow create, update: if approvedRider()
        && activeRide().riderId == request.auth.uid
        && activeRide().status in ['accepted', 'arrived', 'started']
        && request.resource.data.keys().hasOnly(['riderId', 'image'])
        && request.resource.data.riderId == request.auth.uid
        && validFace(request.resource.data.image)
        && request.resource.data.image == get(/databases/$(database)/documents/riderFaceProfiles/$(request.auth.uid)).data.image;
      allow delete: if false;
    }
    // Photo records are separate from ride history and private application documents.
    match /rideDriverPhotos/{rideId} {
      function activeRide() {
        return get(/databases/$(database)/documents/rides/$(rideId)).data;
      }
      function application() {
        return get(/databases/$(database)/documents/driverApplications/$('driver_' + request.auth.uid)).data;
      }
      function activeParticipant() {
        return signedIn() && activeRide().status in ['accepted', 'arrived', 'started']
          && (activeRide().riderId == request.auth.uid || activeRide().driverId == request.auth.uid);
      }
      function validPhoto(photo) {
        return photo is string && photo.size() <= 350000
          && photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+');
      }
      allow get: if admin() || activeParticipant();
      allow list: if false;
      allow create: if driverAccount()
        && activeRide().driverId == request.auth.uid
        && activeRide().status in ['accepted', 'arrived', 'started']
        && request.resource.data.keys().hasOnly(['driverId', 'portrait', 'vehicle', 'plateNumber'])
        && request.resource.data.driverId == request.auth.uid
        && validPhoto(request.resource.data.portrait) && validPhoto(request.resource.data.vehicle)
        && request.resource.data.portrait == application().documents.driverPortrait.image
        && request.resource.data.vehicle == application().documents.vehicleFront.image
        && request.resource.data.plateNumber is string
        && request.resource.data.plateNumber.size() <= 40;
      allow update, delete: if admin();
    }
    match /rides/{rideId} {
      function approved(role) {
        return signedIn()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus in ['approved', 'active'];
      }
      function active() { return resource.data.status in ['accepted', 'arrived', 'started']; }
      function point(location) {
        return location is map && location.keys().hasOnly(['lat', 'lng', 'accuracy', 'heading', 'speed'])
          && location.lat is number && location.lng is number
          && location.lat >= -90 && location.lat <= 90
          && location.lng >= -180 && location.lng <= 180;
      }
      allow read: if admin()
        || (approved('rider') && resource.data.riderId == request.auth.uid)
        || (driverAccount() && (resource.data.status == 'requested' || resource.data.driverId == request.auth.uid));
      allow create: if approved('rider')
        && request.resource.data.keys().hasOnly(['id', 'serviceType', 'serviceDetails', 'pricingStatus', 'riderName', 'riderPhone', 'riderId', 'pickup', 'dropoff', 'pickupLocation', 'dropoffLocation', 'miles', 'durationMinutes', 'fare', 'rideType', 'tipPercent', 'tipAmount', 'totalFare', 'status', 'requestedAt', 'estimatedArrivalMinutes', 'estimatedArrivalAt', 'estimatedFinishAt', 'driverId', 'driverName', 'driverLocation', 'acceptedAt', 'arrivedAt', 'startedAt', 'completedAt', 'cancelledAt'])
        && request.resource.data.id == rideId && request.resource.data.riderId == request.auth.uid
        && request.resource.data.status == 'requested'
        && request.resource.data.driverId == null && request.resource.data.driverName == null
        && request.resource.data.driverLocation == null;
      allow update: if admin() || (!towAssignmentRequest() && ((
        driverAccount() && resource.data.status == 'requested' && resource.data.get('driverId', null) == null
        && (!('serviceType' in resource.data) || resource.data.serviceType != 'tow')
        && request.resource.data.status == 'accepted' && request.resource.data.driverId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'driverId', 'driverName', 'driverPhone', 'vehicleYear', 'vehicleMake', 'vehicleModel', 'acceptedAt'])
        && request.resource.data.acceptedAt is string
      ) || (
        driverAccount() && resource.data.driverId == request.auth.uid && active()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['driverLocation', 'driverLocationUpdatedAt'])
        && point(request.resource.data.driverLocation) && request.resource.data.driverLocationUpdatedAt == request.time
      ) || (
        approved('rider') && resource.data.riderId == request.auth.uid && active()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['riderLocation', 'riderLocationUpdatedAt'])
        && point(request.resource.data.riderLocation) && request.resource.data.riderLocationUpdatedAt == request.time
      ) || (
        driverAccount() && resource.data.driverId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'arrivedAt', 'startedAt', 'completedAt', 'estimatedFinishAt'])
        && ((resource.data.status == 'accepted' && request.resource.data.status == 'started')
          || (resource.data.status == 'started' && request.resource.data.status == 'arrived')
          || (resource.data.status == 'arrived' && request.resource.data.status == 'completed'))
      )));
      allow update: if !towAssignmentRequest() && approved('rider') && resource.data.riderId == request.auth.uid && active()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['riderName','riderPhone'])
        && request.resource.data.riderName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.fullName
        && request.resource.data.riderPhone == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone;
      allow update: if !towAssignmentRequest() && approved('rider') && resource.data.riderId == request.auth.uid
        && resource.data.status in ['requested', 'accepted', 'arrived']
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt']);
      allow delete: if false;
    }
    match /rides/{rideId} {
      function reviewer(role) { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus in ['approved','active']; }
      function validRating(value) { return value is int && value >= 1 && value <= 5; }
      allow update: if resource.data.status == 'completed' && (
        (reviewer('driver') && resource.data.driverId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['riderRating']) && validRating(request.resource.data.riderRating))
        || (reviewer('rider') && resource.data.riderId == request.auth.uid && validRating(request.resource.data.driverRating)
          && (!('driverComment' in request.resource.data) || (request.resource.data.driverComment is string && request.resource.data.driverComment.size() <= 1000))
          && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['driverRating','driverComment'])
          ))
        || (reviewer('rider') && resource.data.riderId == request.auth.uid
          && resource.data.get('tipSubmitted', false) == false
          && resource.data.get('tipAmount', 0) == 0
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tipPercent','tipAmount','totalFare','tipSubmitted'])
          && request.resource.data.tipSubmitted == true
          && resource.data.fare is number && resource.data.fare >= 0
          && resource.data.pricingStatus != 'quote_required'
          && request.resource.data.tipPercent is number && request.resource.data.tipPercent >= 0 && request.resource.data.tipPercent <= 100
          && request.resource.data.tipAmount is number && request.resource.data.tipAmount >= 0
          && request.resource.data.tipAmount >= resource.data.fare * request.resource.data.tipPercent / 100.0 - 0.011
          && request.resource.data.tipAmount <= resource.data.fare * request.resource.data.tipPercent / 100.0 + 0.011
          && request.resource.data.totalFare is number
          && request.resource.data.totalFare >= resource.data.fare + request.resource.data.tipAmount - 0.011
          && request.resource.data.totalFare <= resource.data.fare + request.resource.data.tipAmount + 0.011)

      );
    }
    function towApproved(role) {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus in ['approved','active'];
    }
    function towRide(id) { return get(/databases/$(database)/documents/rides/$(id)).data; }
    function towOpen(id) {
      return towRide(id).serviceType == 'tow' && towRide(id).status == 'requested' && towRide(id).driverId == null;
    }
    function towPrice(value) { return value is number && value > 0 && value <= 100000
        && value * 100 - int(value * 100 + 0.5) >= -0.0001
        && value * 100 - int(value * 100 + 0.5) <= 0.0001; }
    match /rides/{rideId}/towOffers/{driverUid} {
      function rider() { return towApproved('rider') && towRide(rideId).riderId == request.auth.uid; }
      function driver() { return towApproved('driver') && driverUid == request.auth.uid; }
      function detailsMatch() {
        let app = get(/databases/$(database)/documents/driverApplications/$('driver_' + driverUid)).data;
        let next = request.resource.data;
        return app.status == 'approved' && app.uid == driverUid
          && next.driverName == app.fullName && next.driverPhone == app.phone
          && next.vehicleYear == app.vehicleYear && next.vehicleMake == app.vehicleMake && next.vehicleModel == app.vehicleModel;
      }
      function assignedAtPrice(amount) {
        let assigned = getAfter(/databases/$(database)/documents/rides/$(rideId)).data;
        return assigned.status == 'accepted' && assigned.driverId == driverUid
          && assigned.pricingStatus == 'agreed' && assigned.fare == amount;
      }
      allow read: if admin() || rider() || (driver() && (towOpen(rideId) || towRide(rideId).driverId == driverUid));
      allow create: if driver() && towOpen(rideId) && detailsMatch()
        && request.resource.data.keys().hasOnly(['driverId','driverName','driverPhone','vehicleYear','vehicleMake','vehicleModel','amount','counterAmount','status','revision','updatedAt'])
        && request.resource.data.driverId == driverUid && towPrice(request.resource.data.amount)
        && request.resource.data.counterAmount == null && request.resource.data.revision == 1
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.status == 'pending'
          || (request.resource.data.status == 'accepted' && towRide(rideId).pricingStatus != 'quote_required'
            && request.resource.data.amount == towRide(rideId).fare && assignedAtPrice(request.resource.data.amount)));
      allow update: if towOpen(rideId)
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.updatedAt == request.time
        && (
          (driver() && resource.data.status in ['pending','countered','declined']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amount','counterAmount','status','revision','updatedAt'])
            && request.resource.data.status == 'pending' && request.resource.data.counterAmount == null && towPrice(request.resource.data.amount))
          || (driver() && resource.data.status in ['pending','countered','declined']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amount','status','revision','updatedAt'])
            && request.resource.data.status == 'accepted' && towPrice(request.resource.data.amount)
            && (resource.data.status == 'countered'
              ? request.resource.data.amount == resource.data.counterAmount
              : (towRide(rideId).pricingStatus != 'quote_required' && request.resource.data.amount == towRide(rideId).fare))
            && assignedAtPrice(request.resource.data.amount))
          || (rider() && resource.data.status in ['pending','countered']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counterAmount','status','revision','updatedAt'])
            && (
              (request.resource.data.status == 'countered' && towPrice(request.resource.data.counterAmount))
              || (request.resource.data.status == 'declined' && request.resource.data.counterAmount == resource.data.counterAmount)
              || (resource.data.status == 'pending' && request.resource.data.status == 'accepted'
                && request.resource.data.counterAmount == resource.data.counterAmount && assignedAtPrice(resource.data.amount))
            ))
        );
      allow delete: if false;
    }
    match /rides/{rideId}/towOffers/{driverUid}/messages/{messageId} {
      function participant() {
        return (towApproved('rider') && towRide(rideId).riderId == request.auth.uid)
          || (towApproved('driver') && request.auth.uid == driverUid && (towOpen(rideId) || towRide(rideId).driverId == driverUid));
      }
      allow read: if admin() || participant();
      allow create: if participant() && towRide(rideId).serviceType == 'tow'
        && towRide(rideId).status in ['requested','accepted','arrived','started']
        && get(/databases/$(database)/documents/rides/$(rideId)/towOffers/$(driverUid)).data.status in ['pending','countered','accepted']
        && (towRide(rideId).status == 'requested' || towRide(rideId).driverId == driverUid)
        && request.resource.data.keys().hasOnly(['senderId','senderRole','text','createdAt'])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderRole == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /rides/{rideId} {
      function validTowAcceptance() {
        let next = request.resource.data;
        let offerPath = /databases/$(database)/documents/rides/$(rideId)/towOffers/$(next.driverId);
        let previous = exists(offerPath) ? get(offerPath).data : null;
        let chosen = getAfter(offerPath).data;
        let actor = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        let driverProfile = get(/databases/$(database)/documents/users/$(next.driverId)).data;
        let application = get(/databases/$(database)/documents/driverApplications/$('driver_' + next.driverId)).data;
        return actor.accountStatus in ['approved','active']
          && ((actor.role == 'rider' && resource.data.riderId == request.auth.uid && previous != null && previous.status == 'pending')
            || (actor.role == 'driver' && next.driverId == request.auth.uid
              && (previous != null && previous.status == 'countered'
                ? next.fare == previous.counterAmount
                : ((previous == null || previous.status in ['pending','declined'])
                  && resource.data.pricingStatus != 'quote_required' && towPrice(resource.data.fare) && next.fare == resource.data.fare))))
          && next.diff(resource.data).affectedKeys().hasOnly(['status','pricingStatus','fare','tipAmount','totalFare','driverId','driverName','driverPhone','vehicleYear','vehicleMake','vehicleModel','acceptedAt'])
          && next.pricingStatus == 'agreed'
          && chosen.status == 'accepted' && chosen.updatedAt == request.time
          && chosen.driverId == next.driverId && towPrice(chosen.amount) && next.fare == chosen.amount
          && driverProfile.role == 'driver' && driverProfile.accountStatus in ['approved','active'] && application.status == 'approved'
          && next.driverName == chosen.driverName && next.driverPhone == chosen.driverPhone
          && next.vehicleYear == chosen.vehicleYear && next.vehicleMake == chosen.vehicleMake && next.vehicleModel == chosen.vehicleModel
          && resource.data.tipPercent is number && resource.data.tipPercent >= 0 && resource.data.tipPercent <= 100
          && next.tipAmount is number && next.tipAmount >= 0
          && next.tipAmount >= next.fare * resource.data.tipPercent / 100.0 - 0.011
          && next.tipAmount <= next.fare * resource.data.tipPercent / 100.0 + 0.011
          && next.totalFare is number && next.totalFare >= next.fare + next.tipAmount - 0.011
          && next.totalFare <= next.fare + next.tipAmount + 0.011 && next.acceptedAt is string;
      }
      allow update: if signedIn() && resource.data.serviceType == 'tow' && resource.data.status == 'requested' && resource.data.driverId == null
        && request.resource.data.status == 'accepted' && request.resource.data.driverId is string && validTowAcceptance();
    }

    // One shared, append-only conversation for the rider, assigned driver and active admins.
    // Confirmed tolls are append-only. The event and ride aggregate must commit together.
    function tollRide(id) { return get(/databases/$(database)/documents/rides/$(id)).data; }
    function tollDriver(id) {
      return signedIn() && tollRide(id).driverId == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'driver'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus in ['active','approved']
        && tollRide(id).status in ['started','arrived','completed'];
    }
    function validTollEvent(event) {
      return event.keys().hasOnly(['driverId','riderId','amount','location','source','customerAgreed','createdAt'])
        && event.driverId == request.auth.uid && event.source == 'driver-rider-agreed' && event.customerAgreed == true
        && event.amount is number && event.amount > 0 && event.amount <= 500
        && event.amount * 100 - int(event.amount * 100 + 0.5) >= -0.0001
        && event.amount * 100 - int(event.amount * 100 + 0.5) <= 0.0001
        && event.location is string && event.location.size() > 0 && event.location.size() <= 200
        && event.createdAt == request.time;
    }
    match /rides/{rideId} {
      function validTollAggregate() {
        let id = request.resource.data.lastTollId;
        let event = getAfter(/databases/$(database)/documents/rides/$(rideId)/tollEvents/$(id)).data;
        let previous = resource.data.get('tollsAmount', 0);
        let next = request.resource.data.tollsAmount;
        return id is string && id.size() > 0 && id.size() <= 100
          && !exists(/databases/$(database)/documents/rides/$(rideId)/tollEvents/$(id))
          && validTollEvent(event) && event.riderId == resource.data.riderId
          && (resource.data.get('tollAccounting', '') == 'separate-v1'
            || (previous == 0 && resource.data.get('tolls',0) == 0))
          && next is number && next > 0 && next <= 500
          && next >= previous + event.amount - 0.00001
          && next <= previous + event.amount + 0.00001;
      }
      allow update: if tollDriver(rideId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tollsAmount','tollAccounting','lastTollId'])
        && request.resource.data.tollAccounting == 'separate-v1' && validTollAggregate();
    }
    match /rides/{rideId}/tollEvents/{eventId} {
      allow read: if admin() || (signedIn() && (tollRide(rideId).driverId == request.auth.uid || tollRide(rideId).riderId == request.auth.uid));
      allow create: if tollDriver(rideId) && validTollEvent(request.resource.data)
        && request.resource.data.riderId == tollRide(rideId).riderId
        && getAfter(/databases/$(database)/documents/rides/$(rideId)).data.lastTollId == eventId
        && getAfter(/databases/$(database)/documents/rides/$(rideId)).data.tollAccounting == 'separate-v1'
        && getAfter(/databases/$(database)/documents/rides/$(rideId)).data.tollsAmount >= tollRide(rideId).get('tollsAmount',0) + request.resource.data.amount - 0.00001
        && getAfter(/databases/$(database)/documents/rides/$(rideId)).data.tollsAmount <= tollRide(rideId).get('tollsAmount',0) + request.resource.data.amount + 0.00001;
      allow update, delete: if false;
    }

    match /rides/{rideId}/messages/{messageId} {
      function chatRide() { return get(/databases/$(database)/documents/rides/$(rideId)).data; }
      function chatMember() {
        return signedIn() && (admin() || chatRide().riderId == request.auth.uid
          || chatRide().get('driverId', null) == request.auth.uid);
      }
      function chatRole() {
        return (admin() && request.resource.data.senderRole == 'admin')
          || (chatRide().riderId == request.auth.uid && request.resource.data.senderRole == 'rider')
          || (chatRide().get('driverId', null) == request.auth.uid && request.resource.data.senderRole == 'driver');
      }
      allow read: if chatMember();
      allow create: if chatMember() && chatRide().status in ['requested', 'accepted', 'started', 'arrived']
        && request.resource.data.keys().hasOnly(['senderId', 'senderRole', 'text', 'createdAt'])
        && request.resource.data.senderId == request.auth.uid && chatRole()
        && request.resource.data.text is string && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000 && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /emergencies/{emergencyId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['type','emergencyService','source','reporterId','riderId','riderName','driverId','driverName','rideId','status','latitude','longitude','accuracy','mapUrl','createdAt'])
        && request.resource.data.type == 'SOS' && request.resource.data.status == 'active'
        && (!('emergencyService' in request.resource.data) || request.resource.data.emergencyService in ['police','ambulance','fire'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.source in ['rider','driver']
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == request.resource.data.source
        && ((request.resource.data.source == 'driver' && request.resource.data.driverId == request.auth.uid && !('riderId' in request.resource.data)) || (request.resource.data.source == 'rider' && request.resource.data.riderId == request.auth.uid && !('driverId' in request.resource.data)))
        && request.resource.data.latitude is number && request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number && request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180
        && request.resource.data.accuracy is number && request.resource.data.accuracy >= 0
        && request.resource.data.createdAt == request.time
        && (request.resource.data.rideId == null || (request.resource.data.rideId is string && ((request.resource.data.source == 'driver' && get(/databases/$(database)/documents/rides/$(request.resource.data.rideId)).data.driverId == request.auth.uid) || (request.resource.data.source == 'rider' && get(/databases/$(database)/documents/rides/$(request.resource.data.rideId)).data.riderId == request.auth.uid))));
      allow get: if admin() || (signedIn() && resource.data.reporterId == request.auth.uid);
      allow list: if admin();
      allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','acknowledgedAt','resolvedAt']) && request.resource.data.status in ['acknowledged','resolved'];
      allow delete: if false;
    }
    match /driverPresence/{uid} {
      function approvedRole(role) {
        return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus in ['approved','active'];
      }
      function application() { return get(/databases/$(database)/documents/driverApplications/$('driver_' + uid)).data; }
      allow read: if owner(uid) || admin() || approvedRole('rider');
      allow create, update: if owner(uid) && approvedRole('driver') && application().status == 'approved'
        && request.resource.data.keys().hasOnly(['uid','driverName','vehicleYear','vehicleMake','vehicleModel','serviceType','lat','lng','available','updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.driverName == application().fullName
        && request.resource.data.vehicleYear == application().vehicleYear
        && request.resource.data.vehicleMake == application().vehicleMake
        && request.resource.data.vehicleModel == application().vehicleModel
        && request.resource.data.serviceType in ['ride','tow','messenger']
        && request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
        && request.resource.data.available is bool && request.resource.data.updatedAt == request.time;
      allow delete: if owner(uid);
    }
    match /config/{docId} {
      allow read, write: if false;
    }
  }
}


